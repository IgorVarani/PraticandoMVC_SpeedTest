@model IEnumerable<CafeteriaMVC.Models.Inter_ItemUsuario>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Item)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Usuario)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Item.ItemID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Usuario.UsuarioID)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Inter_ItemUsuarioID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Inter_ItemUsuarioID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Inter_ItemUsuarioID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
